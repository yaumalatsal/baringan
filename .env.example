APP_NAME=Baringan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://baringan.duckdns.org

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_DRIVER=database
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Shared secret the status console presents on /api/monitor/*, as
# `X-Monitor-Token` or `Authorization: Bearer`. Must match the value the
# console sends. Unset, those two endpoints answer 503; /api/health stays
# public either way, so liveness monitoring survives.
MONITOR_API_TOKEN=
